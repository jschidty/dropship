{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "drop-ship-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHES",
        "class_name": "MatchDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchDurableObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
