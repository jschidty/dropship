{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@drop-ship/client": ["packages/client/src/index.ts"],
      "@drop-ship/content": ["packages/content/src/index.ts"],
      "@drop-ship/controllers": ["packages/controllers/src/index.ts"],
      "@drop-ship/protocol": ["packages/protocol/src/index.ts"],
      "@drop-ship/server": ["packages/server/src/index.ts"],
      "@drop-ship/sim": ["packages/sim/src/index.ts"],
      "@drop-ship/tools": ["packages/tools/src/index.ts"],
      "@drop-ship/tools/headless-match": [
        "packages/tools/src/headless-match/index.ts"
      ]
    }
  }
}
